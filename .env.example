# Copy to .env and fill in. Everything here is optional — without an API key
# the app runs with a scripted interviewer instead of the AI chat.

# Enables the real AI chat via OpenRouter. Get a key at
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Model used for the chat, as an OpenRouter model id. Must support
# tool/function calling. Defaults to openai/gpt-4o-mini.
# OPENROUTER_MODEL=openai/gpt-4o-mini

# Force the scripted interviewer even when a key is present.
# PRELEGAL_AI_MODE=mock

# HTTP port. Defaults to 3000.
# PORT=3000

# SQLite file location. Defaults to .data/prelegal.db
# DB_PATH=.data/prelegal.db

# Demo mode (default on): every download is watermarked SAMPLE and marked not
# for use, and the site shows a demo notice. Set to off only for a real launch.
# PRELEGAL_DEMO_MODE=on

# Paywall (default off): when on, downloads need a purchased agreement or an
# active plan. Off in the demo, where downloads are free.
# PRELEGAL_PAYMENTS=off

# Payment provider. "test" simulates a successful payment for local testing and
# is refused when NODE_ENV=production. No real provider is connected yet.
# PRELEGAL_PAYMENT_PROVIDER=

# Per-visitor demo limits (default on). Only the evaluation runner turns them off.
# PRELEGAL_DEMO_LIMITS=on
